DLTcalibration/[Bb]uilds/
DLTcalibration/[Ll]ogs/
DLTcalibration/[Uu]ser[Ss]ettings/
DLTcalibration/[Mm]emoryCaptures/
DLTcalibration/[Rr]ecordings/

# IDE가 만드는 파일
.vs/
.idea/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
